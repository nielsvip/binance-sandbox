<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.muse.local-proxy</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/niels/binance/.venv/bin/python</string>
    <string>/Users/niels/Documents/binance/muse_local_proxy.py</string>
    <string>--port</string>
    <string>11435</string>
  </array>
  <key>RunAtLoad</key><false/> <!-- manual start only, not auto on boot -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key><false/>
  </dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/tmp/muse_proxy.log</string>
  <key>StandardErrorPath</key><string>/tmp/muse_proxy.log</string>
  <key>WorkingDirectory</key><string>/Users/niels/Documents/binance</string>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
</dict>
</plist>
